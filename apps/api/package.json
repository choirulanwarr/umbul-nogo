{
  "name": "@umbul-nogo/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/server.ts",
    "build": "bun build --target=bun --packages=external --outdir=dist src/server.ts",
    "start": "bun dist/server.js",
    "check": "bun run --bun tsc -p tsconfig.json",
    "verify:sharp": "bun scripts/verify-sharp.ts",
    "db:generate": "bun run --bun drizzle-kit generate",
    "db:migrate": "bun scripts/migrate.ts",
    "db:fixture": "bun scripts/fixture.ts",
    "test:db": "bun --config ./bunfig.toml test ./tests/database.integration.test.ts"
  },
  "dependencies": {
    "@umbul-nogo/contracts": "workspace:*",
    "drizzle-orm": "0.45.2",
    "elysia": "1.4.30",
    "sharp": "0.35.4"
  },
  "devDependencies": {
    "drizzle-kit": "0.31.10"
  }
}
