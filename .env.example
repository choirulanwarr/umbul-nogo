# API startup requires SITE_ORIGIN and DATABASE_URL. Fill DATABASE_URL with the runtime role only.
SITE_ORIGIN=http://127.0.0.1:5173
DATABASE_URL=
API_HOST=127.0.0.1
API_PORT=3001
API_INTERNAL_URL=http://127.0.0.1:3001
# Production web server (svelte-adapter-bun).
HOST=127.0.0.1
PORT=3000
ORIGIN=http://127.0.0.1:3000
