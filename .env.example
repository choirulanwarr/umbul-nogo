# API startup requires SITE_ORIGIN and DATABASE_URL. Fill DATABASE_URL with the runtime role only.
SITE_ORIGIN=http://127.0.0.1:5173
DATABASE_URL=
API_HOST=127.0.0.1
API_PORT=3001
API_INTERNAL_URL=http://127.0.0.1:3001
# Production web server (svelte-adapter-bun).
HOST=127.0.0.1
PORT=3000
ORIGIN=http://127.0.0.1:3000
# T-04: provision PostgreSQL using the separate .env.database.example template.
# Only DATABASE_URL belongs in API runtime; migration/admin/test URLs stay private
# to operator scripts. T-05 connects the application lifecycle to the pool.
# T-10: leave all S3 fields empty to keep uploads unavailable (503) during setup.
# MEDIA_BASE_URL can be configured alone to keep existing images readable.
# Runtime credentials belong only to API; never expose them through PUBLIC_* vars.
MEDIA_BASE_URL=
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_SESSION_TOKEN=
# Optional true/false. Default false; set true for virtual-hosted bucket addressing.
S3_VIRTUAL_HOSTED_STYLE=
