# Local operator file only: copy to .env.database.local (ignored by Git).
# Fill all six independent passwords; Docker Compose expands both profiles.
DEV_POSTGRES_PASSWORD=
DEV_MIGRATION_PASSWORD=
DEV_RUNTIME_PASSWORD=
TEST_POSTGRES_PASSWORD=
TEST_MIGRATION_PASSWORD=
TEST_RUNTIME_PASSWORD=

# Replace password placeholders with the matching URL-encoded local passwords.
# Give only DATABASE_URL to the API runtime, never the operator/test secrets.
DATABASE_URL=postgresql://umbul_runtime:REPLACE_DEV_RUNTIME_PASSWORD@127.0.0.1:5433/umbul_nogo_development
MIGRATION_DATABASE_URL=postgresql://umbul_migrator:REPLACE_DEV_MIGRATION_PASSWORD@127.0.0.1:5433/umbul_nogo_development
TEST_DATABASE_URL=postgresql://umbul_runtime:REPLACE_TEST_RUNTIME_PASSWORD@127.0.0.1:5434/umbul_nogo_test
TEST_MIGRATION_DATABASE_URL=postgresql://umbul_migrator:REPLACE_TEST_MIGRATION_PASSWORD@127.0.0.1:5434/umbul_nogo_test
# Leave disabled until the corresponding action is explicitly intended.
ALLOW_DEVELOPMENT_FIXTURE=
ALLOW_DATABASE_TESTS=
